# ===== 環境依存・再現可能なもの =====
# requirements.txt があれば再構築できるため、仮想環境自体はGit管理しない
venv/
venv_win/
__pycache__/

# ===== 秘密情報 =====
# APIキーなど。漏洩防止のため必ず除外
.env

# ===== 容量が大きい生成物 =====
# download_datasets.py を再実行すれば取得できるため、データセット本体は管理しない
datasets/

# 学習を再実行すれば生成できるため、モデルの重み・学習ログは管理しない
*.pt
*.pth
runs/

# realtime_pose_detect.py が初回実行時に自動ダウンロードするMediaPipeの
# Pose Landmarkerモデル(容量が大きく、再ダウンロードで復元できるため)
*.task

# ===== プライバシー・容量 =====
# 撮影した画像・動画(自分が写り込む可能性があるものを含む)
images/
# 大文字の拡張子(スマホやカメラの IMG_0001.JPG、CLIP.MOV など)も除外する(WSL の Git は大文字・小文字を区別する)
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[mM][pP]4
*.[aA][vV][iI]
*.[mM][oO][vV]
*.[mM][kK][vV]
*.[wW][eE][bB][mM]
*.[wW][mM][vV]
*.[mM]4[vV]
*.[bB][mM][pP]
*.[gG][iI][fF]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[hH][eE][iI][cC]
*.[wW][eE][bB][pP]

# 実行のたびに増える計測データ(バージョン管理する意味が薄い)
trajectories/
shuttle_trajectory*.csv

# realtime_pose_detect.py の出力(人物の立ち位置ログ。プライバシー配慮も兼ねて除外)
person_positions/

# launch_control/ の発射ごとの記録(人の立ち位置を含むため、person_positions/ と同じ理由で除外)
launch_control/shots/
# integration/ の自動版の記録は、学習データとして Git で共有する。
# 映像が絶対に入らないよう、フォルダの中はすべて除外し、発射の記録 shots_*.csv(数字だけ)だけを許可する。
integration/shots/*
!integration/shots/shots_*.csv
